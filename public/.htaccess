
# Security Headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer-when-downgrade"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; font-src 'self' https:; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; connect-src 'self' https:;"
</IfModule>

# Enable URL rewriting
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force www subdomain
  RewriteCond %{HTTP_HOST} !^www\.antonyaddy\.com$ [NC]
  RewriteRule ^ https://www.antonyaddy.com%{REQUEST_URI} [L,R=301]

  # Normalize trailing slash policy (no trailing slash except root)
  RewriteCond %{REQUEST_URI} .+/$
  RewriteRule ^(.+)/$ https://www.antonyaddy.com/$1 [L,R=301]

  # 301 Redirects for legacy antonyaddy.com pages
  RewriteRule ^services/?$ / [R=301,L]
  RewriteRule ^tarifs-cpf/?$ / [R=301,L]
  RewriteRule ^videos/?$ / [R=301,L]
  RewriteRule ^faq/?$ / [R=301,L]
  RewriteRule ^a-propos/?$ /qui-je-suis [R=301,L]
  RewriteRule ^contactez-moi/?$ /contact [R=301,L]
  RewriteRule ^ressources-et-conseils/?$ / [R=301,L]
  RewriteRule ^ipsum-autem-impedit-nisi/?$ / [R=301,L]
  RewriteRule ^formations-et-services/?$ /offres-de-formation [R=301,L]
  RewriteRule ^tag/ad/?$ / [R=301,L]
  RewriteRule ^votre-besoin/?$ / [R=301,L]
  RewriteRule ^lander/?$ / [R=301,L]
  RewriteRule ^est-ut-praesentium-voluptatibus-et/?$ / [R=301,L]
  RewriteRule ^assumenda-nisi-nemo-labore-error/?$ / [R=301,L]
  RewriteRule ^ullam-omnis-et-voluptatum-quis-quia/?$ / [R=301,L]
  RewriteRule ^hellofacture/?$ / [R=301,L]
  RewriteRule ^avis-clients/?$ /temoignages [R=301,L]
  RewriteRule ^reseaux-sociaux/?$ / [R=301,L]
  RewriteRule ^velit-et-eum-id-nobis-velit/?$ / [R=301,L]
  RewriteRule ^aut-quo-eos-qui-odit-amet/?$ / [R=301,L]
  RewriteRule ^velit-cumque-quos-harum-aut/?$ / [R=301,L]
  RewriteRule ^jeux-anglais/?$ /anglaisadistance [R=301,L]

  # Catch-all for any /products/* routes (Shopify legacy)
  RewriteRule ^products/.*$ / [R=301,L]

  # Serve sitemap.xml as a real XML file, not routed through index.html
  RewriteRule ^sitemap\.xml$ - [L]

  # Prevent routing sitemap.xml to SPA fallback
  RewriteRule ^index\.html$ - [L]

  # SPA fallback: route all non-file, non-folder requests to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Force correct MIME type for XML files
AddType application/xml .xml

# Optional: charset and compression
AddDefaultCharset UTF-8
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/xml
</IfModule>

# === Efficient caching for static assets ===
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType application/json "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|json|svg|webp|avif|png|jpe?g|gif|woff2)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>
