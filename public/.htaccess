# Allow sitemap.xml to be served directly and NOT rewritten
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let sitemap.xml through
  RewriteRule ^sitemap\.xml$ - [L]

  # Let index.html pass
  RewriteRule ^index\.html$ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
