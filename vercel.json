  "rewrites": [
    {
      "source": "/whatsapp",
      "destination": "/api/whatsapp"
    },
    {
      "source": "/sites-web",
      "destination": "https://creations.antonyaddy.com/sites-web"
    },
    {
      "source": "/sites-web/:path*",
      "destination": "https://creations.antonyaddy.com/sites-web/:path*"
    },
    {
      "source": "/books",
      "destination": "https://books.antonyaddy.com/books"
    },
    {
      "source": "/books/:path*",
      "destination": "https://books.antonyaddy.com/books/:path*"
    },
    {
      "source": "/toeic",
      "destination": "https://toeic.antonyaddy.com/toeic"
    },
    {
      "source": "/toeic/:path*",
      "destination": "https://toeic.antonyaddy.com/toeic/:path*"
    },
    {
      "source": "/grammatica",
      "destination": "https://grammatica.antonyaddy.com/grammatica"
    },
    {
      "source": "/grammatica/:path*",
      "destination": "https://grammatica.antonyaddy.com/grammatica/:path*"
    },
    {
      "source": "/listening",
      "destination": "https://listening.antonyaddy.com/listening"
    },
    {
      "source": "/listening/:path*",
      "destination": "https://listening.antonyaddy.com/listening/:path*"
    },
    {
      "source": "/ia",
      "destination": "https://ia.antonyaddy.com/ia"
    },
    {
      "source": "/ia/:path*",
      "destination": "https://ia.antonyaddy.com/ia/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/lovable-uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/((?!(?:sites-web|books|toeic|grammatica|listening|ia)(?:/|$)).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; img-src 'self' data: blob: https:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com; media-src 'self' https: blob:; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://wa.me https://api.whatsapp.com; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
