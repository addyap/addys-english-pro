# Supabase — required by the contact form and questionnaire at runtime.
# Both are public, client-side values (the publishable/anon key, not the
# service_role key). Copy them from the Supabase dashboard:
#   Project Settings → API → Project URL / Project API keys → anon public
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Optional Google Analytics 4 (leave blank to disable)
VITE_GA_ID=G-XXXXXXXXXX
