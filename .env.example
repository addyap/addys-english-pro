# Umami — cookieless audience measurement. Both must be set for any analytics
# to be collected; `trackEvent` is a safe no-op until then, so the site works
# identically with or without them.
VITE_UMAMI_SRC=https://your-umami-host/script.js
VITE_UMAMI_WEBSITE_ID=your-website-id

# Resend — transactional email for the contact form (server-side only, used by
# api/send-contact-email.ts).
RESEND_API_KEY=re_xxxxxxxxxxxx

# Optional — signs the contact form's proof-of-work challenges
# (api/_lib/form-guard.ts). Any long random string. If unset, a key derived
# from RESEND_API_KEY is used, so the protection works without it.
# FORM_SECRET=

# Removed: all Supabase vars (VITE_SUPABASE_*, SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY) — the site uses no database; the contact form's
# rate limit is in-memory. Also removed: VITE_GA_ID (no Google Analytics here;
# Umami is the analytics).
