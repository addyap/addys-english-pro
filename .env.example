# Umami — cookieless audience measurement. Both must be set for any analytics
# to be collected; `trackEvent` is a safe no-op until then, so the site works
# identically with or without them.
VITE_UMAMI_SRC=https://your-umami-host/script.js
VITE_UMAMI_WEBSITE_ID=your-website-id

# Resend — transactional email for the contact form (server-side only, used by
# api/send-contact-email.ts).
RESEND_API_KEY=re_xxxxxxxxxxxx

# Supabase — SERVER-ONLY, used by api/send-contact-email.ts for the
# consume_rate_limit() RPC that throttles contact-form abuse.
#
# Deliberately NOT the VITE_-prefixed client vars: these must never reach the
# browser, since the service-role key bypasses row-level security. This site has
# no Supabase project of its own; it reuses the anglaisadistance.fr project.
# Copy both from that dashboard (Settings > API).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Removed: VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY (the browser-side
# Supabase client was unused and has been deleted — only the server vars above
# are needed) and VITE_GA_ID (no Google Analytics here; Umami is the analytics).
